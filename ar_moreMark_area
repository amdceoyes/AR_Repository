# 导入必要的Python库
import cv2           # OpenCV：计算机视觉库，用于图像处理和AR标记检测
import cv2.aruco as aruco  # OpenCV的ARUco模块，用于检测和识别AR标记
import numpy as np   # NumPy：科学计算库，处理数组和矩阵运算
import time         # 时间模块，用于性能监控和FPS计算

class ProfessionalARSystem:
    """
    专业级增强现实系统类
    采用模块化、垂直整合的设计理念，包含感知、状态管理和渲染三个核心层次
    """
    
    def __init__(self, camera_matrix, dist_coeffs):
        """
        初始化专业级AR系统
        采用"垂直整合"设计理念：从硬件参数到渲染表现的完整集成
        
        参数:
        camera_matrix: 相机内参矩阵，3x3的numpy数组
                       [[fx, 0, cx],
                        [0, fy, cy],
                        [0, 0, 1]]
        dist_coeffs: 相机畸变系数，用于修正镜头畸变
        """
        # --- 1. 硬件层配置 ---
        # 存储相机物理参数，这是整个AR系统的"眼睛"
        self.camera_matrix = camera_matrix
        self.dist_coeffs = dist_coeffs
        
        # --- 2. 感知层配置 ---
        # 定义ARUco字典：4x4网格，50种不同标记
        # 这相当于系统的"识别字典"，告诉系统要识别什么样的标记
        self.aruco_dict = aruco.getPredefinedDictionary(aruco.DICT_4X4_50)
        
        # 创建检测器参数对象
        self.params = aruco.DetectorParameters()
        
        # 核心优化：开启亚像素细化
        # 物理层减少坐标抖动的关键技术
        # 亚像素细化：在像素级别内更精确地定位角点，提高检测精度
        self.params.cornerRefinementMethod = aruco.CORNER_REFINE_SUBPIX
        
        # --- 3. 状态管理层（记忆与平滑）---
        # 使用字典存储每个标记的历史状态
        # 格式: {marker_id: {"rvec": 旋转向量, "tvec": 平移向量, "miss": 失踪计数}}
        self.history = {} 
        
        # 滤波系数α：控制平滑程度
        # α越小，系统越"保守"，抖动越小但响应延迟越大
        # α=0.15 表示：新数据占15%，历史数据占85%
        self.alpha = 0.15      
        
        # 最大容错帧数：即使标记被遮挡，也能维持显示10帧
        # 这避免了标记短暂消失导致的虚拟物体闪烁
        self.max_miss = 10     
        
        # --- 4. 表现层配置：3D模型定义 ---
        # 定义立方体的8个顶点（中心化坐标系）
        # 中心化：以标记中心为原点，便于后续变换
        s = 0.05  # 立方体边长5厘米
        self.cube_pts = np.float32([
            # 底面4个顶点（z=0平面）
            [-s/2, -s/2, 0],  # 左前下
            [ s/2, -s/2, 0],  # 右前下
            [ s/2,  s/2, 0],  # 右后下
            [-s/2,  s/2, 0],  # 左后下
            
            # 顶面4个顶点（z=-s平面，向下延伸）
            [-s/2, -s/2, -s],  # 左前上
            [ s/2, -s/2, -s],  # 右前上
            [ s/2,  s/2, -s],  # 右后上
            [-s/2,  s/2, -s],  # 左后上
        ])

    def update_and_render(self, frame):
        """
        主流水线：垂直整合感知、状态与渲染
        这是系统的核心处理函数，一帧图像从这里进入，被处理并返回
        
        参数:
        frame: 输入图像帧（BGR格式）
        返回: 处理后的图像帧（已绘制虚拟物体）
        """
        # 1. 图像预处理：转换为灰度图
        # ARUco检测只需要亮度信息，灰度图处理更快
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        
        # 2. 感知层：检测ARUco标记
        # corners: 每个标记的4个角点坐标
        # ids: 每个标记的ID
        # _: 被拒绝的候选标记（这里用_忽略，不需要）
        corners, ids, _ = aruco.detectMarkers(gray, self.aruco_dict, parameters=self.params)

        # --- A. 时序递增：所有记忆的"失踪计数"先增加 ---
        # 每一帧，所有已知标记的失踪计数+1
        # 这模拟了"如果没有新观测，标记就离我们越来越远"的概念
        for m_id in self.history:
            self.history[m_id]["miss"] += 1

        # --- B. 感知注入：如果检测到新信号，更新记忆 ---
        if ids is not None:
            # 批量计算所有检测到的标记的3D姿态
            # 0.05: 标记的实际物理尺寸（5厘米）
            rvecs, tvecs, _ = aruco.estimatePoseSingleMarkers(
                corners, 0.05, self.camera_matrix, self.dist_coeffs
            )
            
            # 遍历所有检测到的标记
            for i in range(len(ids)):
                # 获取当前标记的ID（转换为int，用作字典键）
                curr_id = int(ids[i][0])
                # 更新这个标记的状态
                self._update_marker_state(curr_id, rvecs[i][0], tvecs[i][0])

        # --- C. 渲染表现：遍历记忆库进行绘制 ---
        return self._render_all(frame)

    def _update_marker_state(self, m_id, rvec, tvec):
        """
        垂直整合：将当前观测与历史状态混合
        使用指数加权移动平均(EWMA)进行平滑滤波
        
        参数:
        m_id: 标记ID
        rvec: 当前帧检测到的旋转向量
        tvec: 当前帧检测到的平移向量
        """
        # 如果这个标记是第一次被检测到
        if m_id not in self.history:
            # 初始化记忆：直接使用当前观测值
            self.history[m_id] = {
                "rvec": rvec,  # 旋转向量
                "tvec": tvec,  # 平移向量
                "miss": 0      # 失踪计数清零
            }
        else:
            # 如果标记已有历史记录，进行平滑滤波
            h = self.history[m_id]  # 获取历史状态
            
            # 核心滤波公式：指数加权移动平均(EWMA)
            # 新平滑值 = (1-α)*历史值 + α*新观测值
            # 对旋转向量和平移向量分别进行平滑
            h["rvec"] = (1 - self.alpha) * h["rvec"] + self.alpha * rvec
            h["tvec"] = (1 - self.alpha) * h["tvec"] + self.alpha * tvec
            
            # 重置失踪计数为0（因为这一帧又看到了）
            h["miss"] = 0

    def _render_all(self, frame):
        """
        表现层：遍历所有有效的记忆状态并投影
        将3D虚拟物体渲染到2D图像上
        
        参数:
        frame: 要渲染的图像帧
        返回: 渲染后的图像帧
        """
        # 准备要删除的标记列表
        to_del = []
        
        # 遍历所有已知标记的状态
        for m_id, state in self.history.items():
            # 如果标记最近max_miss帧内被看到过
            if state["miss"] <= self.max_miss:
                # 渲染这个标记上的虚拟物体
                self._draw_cube(frame, state["rvec"], state["tvec"], m_id)
            else:
                # 如果标记连续max_miss帧没被看到，标记为待删除
                to_del.append(m_id)
        
        # 清理过期记忆：删除长时间未见的标记
        for m_id in to_del:
            del self.history[m_id]
            
        return frame

    def _draw_cube(self, frame, rvec, tvec, m_id):
        """
        底层绘制逻辑：在标记位置上绘制3D立方体
        
        参数:
        frame: 要绘制的图像帧
        rvec: 旋转向量（标记的方向）
        tvec: 平移向量（标记的位置）
        m_id: 标记ID，用于颜色区分
        """
        # 1. 将3D立方体顶点投影到2D图像平面
        # 使用相机参数和标记姿态，计算每个3D点在图像中的像素位置
        imgpts, _ = cv2.projectPoints(
            self.cube_pts,  # 3D立方体顶点
            rvec,  # 旋转向量
            tvec,  # 平移向量
            self.camera_matrix,  # 相机内参
            self.dist_coeffs  # 畸变系数
        )
        
        # 2. 将投影点转换为整数像素坐标
        imgpts = np.int32(imgpts).reshape(-1, 2)
        
        # 3. 风格化：根据标记ID分配不同颜色
        # ID 0 用橙色 (BGR: 0,165,255)
        # 其他ID用绿色 (BGR: 100,255,0)
        if m_id == 0:
            color = (0, 165, 255)  # 橙色
        else:
            color = (100, 255, 0)  # 绿色
        
        # 4. 绘制底面：填充底面矩形
        # 使用填充绘制(-1)创建实心效果
        cv2.drawContours(frame, [imgpts[:4]], -1, color, -1) 
        
        # 5. 绘制4条垂直边（连接底面和顶面）
        for i in range(4):
            # 绘制垂直线（白色，线宽2像素）
            cv2.line(frame, 
                    tuple(imgpts[i]),  # 底面顶点
                    tuple(imgpts[i+4]),  # 对应顶面顶点
                    (255, 255, 255),  # 白色
                    2)  # 线宽
            
            # 绘制侧面四边形边框
            # 创建一个四边形：底面顶点i, 底面顶点(i+1)%4, 顶面对应点, 顶面顶点i
            side_pts = np.array([
                imgpts[i],  # 当前底面顶点
                imgpts[(i+1)%4],  # 下一个底面顶点
                imgpts[(i+1)%4+4],  # 下一个顶面顶点
                imgpts[i+4]  # 当前顶面顶点
            ])
            
            # 绘制侧面边框（使用标记颜色，线宽1像素）
            cv2.drawContours(frame, [side_pts], -1, color, 1)

# --- 运行逻辑 (Main Loop) ---
if __name__ == "__main__":
    """
    主程序入口
    演示如何使用ProfessionalARSystem类
    """
    
    # 1. 定义相机参数（示例值，实际应用中需要相机标定）
    # 内参矩阵K
    K = np.array([
        [650, 0, 320],   # fx=650, cx=320
        [0, 650, 240],   # fy=650, cy=240
        [0, 0, 1]        # 齐次坐标
    ], dtype=float)
    
    # 畸变系数D（假设相机没有明显畸变）
    D = np.zeros((4, 1))
    
    # 2. 创建专业级AR系统实例
    ar_system = ProfessionalARSystem(K, D)
    
    # 3. 打开摄像头
    # 参数0：默认摄像头
    # 可以改为视频文件路径，如"video.mp4"
    cap = cv2.VideoCapture(0)
    
    # 检查摄像头是否成功打开
    if not cap.isOpened():
        print("错误：无法打开摄像头")
        exit(1)
    
    # 4. 性能监控：初始化FPS计算变量
    p_time = 0  # 上一帧时间
    
    # 5. 主循环：处理每一帧
    while True:
        # 读取一帧图像
        ret, frame = cap.read()
        if not ret:
            print("错误：无法读取视频帧")
            break
        
        # 执行系统更新：处理当前帧
        processed_frame = ar_system.update_and_render(frame)
        
        # 6. 性能监控：计算并显示FPS
        c_time = time.time()  # 当前时间
        
        # 计算帧率：FPS = 1 / 时间间隔
        # 避免除零错误：检查时间间隔是否大于0
        if c_time - p_time > 0:
            fps = 1 / (c_time - p_time)
        else:
            fps = 0
            
        p_time = c_time  # 更新上一帧时间
        
        # 在图像左上角显示FPS
        cv2.putText(
            processed_frame,  # 要绘制的图像
            f"FPS: {int(fps)}",  # 显示的文本
            (10, 30),  # 文本位置 (x, y)
            cv2.FONT_HERSHEY_SIMPLEX,  # 字体类型
            0.8,  # 字体大小
            (0, 255, 0),  # 颜色：绿色
            2  # 线宽
        )
        
        # 7. 显示处理后的图像
        cv2.imshow('专业级AR系统', processed_frame)
        
        # 8. 检查退出条件
        # 按'q'键退出程序
        # waitKey(1)等待1毫秒，返回按键的ASCII码
        # 0xFF是掩码，用于获取正确的按键值
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break
    
    # 9. 释放资源
    cap.release()  # 释放摄像头
    cv2.destroyAllWindows()  # 关闭所有OpenCV窗口


